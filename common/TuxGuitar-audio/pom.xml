<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<parent>
		<artifactId>tuxguitar-pom</artifactId>
		<groupId>app.tuxguitar</groupId>
		<version>9.99-SNAPSHOT</version>
		<relativePath>../../desktop/</relativePath>
	</parent>

	<!-- Audio tracks, line-in recording and VST3 hosting: a headless engine (sound chain, takes, an offline render
		clock), so its features run without the desktop app. The features in src/test/resources/features not
		implemented yet are @planned (see the README there). -->
	<modelVersion>4.0.0</modelVersion>
	<artifactId>tuxguitar-audio</artifactId>
	<packaging>jar</packaging>
	<name>${project.artifactId}</name>

	<properties>
		<skipTests>false</skipTests>
		<!-- the VST3 host process and the test plugins, built by TuxGuitar-vst3's native build (see its pom) -->
		<vst3.native.dir>${project.basedir}/../TuxGuitar-vst3/native-build</vst3.native.dir>
	</properties>

	<build>
		<sourceDirectory>src/main/java</sourceDirectory>
		<plugins>
			<!-- the scenarios load the test plugins in the real host process: build them first (once; then a no-op), or
				stop here saying what C++ toolchain to install -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>1.7</version>
				<executions>
					<execution>
						<id>build-vst3-native</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${skipTests}</skip>
							<target name="build-vst3-native">
								<exec executable="cmd" osfamily="windows" failonerror="true">
									<arg value="/c" />
									<arg value="${project.basedir}/../TuxGuitar-vst3/native/build.cmd" />
									<arg value="${vst3.native.dir}" />
								</exec>
								<exec executable="sh" osfamily="unix" failonerror="true">
									<arg value="${project.basedir}/../TuxGuitar-vst3/native/build.sh" />
									<arg value="${vst3.native.dir}" />
								</exec>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<tg.vst3.native>${vst3.native.dir}</tg.vst3.native>
					</systemPropertyVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<!-- same JUnit and Cucumber lines as tuxguitar-editor-utils -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.junit</groupId>
				<artifactId>junit-bom</artifactId>
				<version>5.14.4</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>io.cucumber</groupId>
				<artifactId>cucumber-bom</artifactId>
				<version>7.34.9</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-lib</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- the TuxGuitar Synthesizer's host core and its Gervill source, headless: General MIDI programs -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-synth-core</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<dependency>
			<groupId>media.sound</groupId>
			<artifactId>gervill</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- VST3 effects and instruments, in the host process -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-vst3</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<!-- the native audio backend's interface (the scenarios drive a double of it, see TestBackend) -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-audio-device</artifactId>
			<version>${project.version}</version>
			<scope>provided</scope>
		</dependency>
		<!-- editing actions and undo -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-editor-utils</artifactId>
			<scope>provided</scope>
		</dependency>
		<!-- the scenarios run the actions through editor-utils' SongActionFixture, and read MIDI routes -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-editor-utils</artifactId>
			<version>${project.version}</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gm-utils</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- the other file formats a song is exported to: MIDI and Guitar Pro 5 -->
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-midi</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>${project.groupId}</groupId>
			<artifactId>tuxguitar-gtp</artifactId>
			<version>${project.version}</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.jupiter</groupId>
			<artifactId>junit-jupiter-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.junit.platform</groupId>
			<artifactId>junit-platform-suite</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-java</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-junit-platform-engine</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.cucumber</groupId>
			<artifactId>cucumber-picocontainer</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
